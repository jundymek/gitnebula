# A workspace filter that matches no project must fail, not silently succeed.
#
# pnpm's default is to print "No projects matched the filters" and exit 0, so
# `pnpm --filter <typo> test` reports green having run nothing. That turned a
# test obligation into a decorative one for every story whose spec quoted a
# stale package name (see docs/dev/epic-5/5.9-repo-test-command-false-green).
fail-if-no-match=true
