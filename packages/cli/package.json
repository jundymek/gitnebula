{
  "name": "gitnebula",
  "version": "0.1.0",
  "description": "Turn any git repository into an interactive architecture map. One command, no config, fully offline.",
  "keywords": [
    "git",
    "architecture",
    "visualization",
    "dependency-graph",
    "code-analysis",
    "codebase",
    "churn",
    "hotspots",
    "cli",
    "offline"
  ],
  "homepage": "https://github.com/jundymek/gitnebula#readme",
  "bugs": "https://github.com/jundymek/gitnebula/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jundymek/gitnebula.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "gitnebula": "dist/bin/gitnebula.js"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup && node scripts/assemble-assets.mjs",
    "prepack": "node scripts/assemble-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "open": "^11.0.0",
    "typescript": "^5.9.3",
    "web-tree-sitter": "^0.26.12",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@gitnebula/contract": "workspace:*",
    "@gitnebula/deps": "workspace:*",
    "@gitnebula/githist": "workspace:*",
    "@gitnebula/scanner": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "^8.5.1",
    "vitest": "catalog:"
  }
}
