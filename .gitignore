# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# What `packages/cli`'s prepack assembles for the tarball (AD-11): the built
# Viewer, the grammar copied out of `packages/deps/assets` (which IS committed,
# hence the explicit paths), and the licence and readme copied from the
# workspace root — the readme with its relative links rewritten absolute, since
# npm renders it off-repository. All four are regenerated artefacts; the tarball
# is where they belong.
packages/cli/assets/
packages/cli/LICENSE
packages/cli/README.md
packages/cli/*.tgz

# The bundle `gitnebula build` writes when run in this repository — its default
# output directory, and the one CI uses.
/gitnebula-bundle/
/.gitnebula-site/

# Generated fixture repositories (AD-14) — built by scripts, never committed
test-fixtures/.generated/

# What `gitnebula` writes when run here with no --out. Root-anchored, so the
# committed fixtures under packages/ and any bundle sibling (ADR-0004) are
# unaffected.
/analysis.json

# Promo-video workspace: an experiment kept out of the repository's history by
# choice. Not project source — the map gitnebula draws of itself excludes it.
/marketing/

# BMAD personal settings (per-developer, not shared)
_bmad/config.user.toml
_bmad/custom/config.user.toml

# OS / editor
.DS_Store
*.log

# perf-spike run output (regenerated on every run; the recorded evidence
# lives in docs/dev/epic-1/1.4-perf-spike/results.json)
packages/viz/perf-spike/results.json

# Story 3.5 perf harness output. Regenerated on every `pnpm --filter
# @gitnebula/viz perf`; the numbers that count are transcribed into
# docs/dev/epic-3/3.5-viz-export-perf/PERFORMANCE.md, where they are reviewed
# rather than overwritten.
packages/viz/perf/report/
packages/viz/test-results/
packages/viz/playwright-report/
